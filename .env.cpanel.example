# ───────────────────────────────────────────────────────────────────
# Samutkarsh Portal — .env for cPanel (samutkarshias.in)
# Copy to `.env` in the APP folder (/home/goayu/samutkarsh_app). Fill the gaps.
# ───────────────────────────────────────────────────────────────────

APP_NAME="Samutkarsh IAS Academy"
APP_ENV=production
# Pre-generated for you (no CLI needed). You may rotate it later.
# Set this in your SERVER .env only — never commit a real key (this repo is public).
APP_KEY=
APP_DEBUG=false
APP_URL=https://samutkarshias.in

# --- Database (from cPanel → MySQL Databases) ---
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=goayu_samutkarsh-portal
DB_USERNAME=goayu_samutkarsh-portal
DB_PASSWORD="CHANGE_ME_after_deploy"

# --- Sessions / cache / queue ---
# file-based: no DB tables needed, so the web installer can bootstrap on a
# fresh database. (Switch to 'database' later if you prefer, after install.)
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- Mail: this server has sendmail, so notifications work with no SMTP setup ---
MAIL_MAILER=sendmail
MAIL_FROM_ADDRESS="admissions@samutkarshias.in"
MAIL_FROM_NAME="${APP_NAME}"

# --- Admissions ---
ADMISSION_YEAR=2026
ADMISSION_REGISTRATION_OPEN=true
ADMISSION_FEE=5000

# --- Payments ---
UPI_QR_ENABLED=true
UPI_VPA=samutkarsh@upi
UPI_PAYEE_NAME="Samutkarsh IAS Academy"
CASH_ENABLED=true
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── ONE-TIME INSTALL (web installer at /__setup?token=…) ──
# Set a long random string. After install succeeds, DELETE these 4 lines.
INSTALL_TOKEN=
INSTALL_ADMIN_NAME="Trust Admin"
INSTALL_ADMIN_EMAIL=you@samutkarshias.in
INSTALL_ADMIN_PASSWORD=
