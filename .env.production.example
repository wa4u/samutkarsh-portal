# ───────────────────────────────────────────────────────────────────
# Samutkarsh Portal — PRODUCTION environment template
# Copy to `.env` on the server and fill in real values. Never commit .env.
# ───────────────────────────────────────────────────────────────────

APP_NAME="Samutkarsh IAS Academy"
APP_ENV=production
APP_KEY=                              # set via: php artisan key:generate
APP_DEBUG=false
APP_URL=https://samutkarshias.in

# --- Database (MySQL) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=samutkarsh
DB_USERNAME=samutkarsh_user
DB_PASSWORD=

# --- Sessions / cache / queue ---
# Notifications are queued; 'sync' sends inline (no worker). Use 'database'
# (run `php artisan queue:table && migrate`) or 'redis' + a worker for scale.
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync

# --- Mail (status-change notifications) ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="admissions@samutkarshias.in"
MAIL_FROM_NAME="${APP_NAME}"

# --- Admissions ---
ADMISSION_YEAR=2026
ADMISSION_REGISTRATION_OPEN=true
ADMISSION_FEE=5000

# --- Payments: UPI QR (manual confirm) ---
UPI_QR_ENABLED=true
UPI_VPA=samutkarsh@upi
UPI_PAYEE_NAME="Samutkarsh IAS Academy"

# --- Payments: Cash (manual entry) ---
CASH_ENABLED=true

# --- Payments: Razorpay (online; webhook -> /payments/webhook/razorpay) ---
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
